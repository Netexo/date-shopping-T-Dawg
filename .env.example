# Password-free admin login via GitHub OAuth (server-only).
# Register an OAuth app and allow the exact callback: <ADMIN_AUTH_ORIGIN>/api/admin/callback
ADMIN_AUTH_ORIGIN=
ADMIN_GITHUB_CLIENT_ID=
ADMIN_GITHUB_CLIENT_SECRET=
# Numeric GitHub account ID for the single allowed administrator (not username).
ADMIN_GITHUB_USER_ID=
# Independent random signing secret, at least 32 characters.
ADMIN_SESSION_SECRET=

# Server-only token for the existing private Vercel Blob Store.
BLOB_READ_WRITE_TOKEN=
